{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: package",
      "type": "shell",
      "command": "mvn -DskipTests package",
      "group": "build",
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Maven: spring-boot:run",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Maven: test",
      "type": "shell",
      "command": "mvn test",
      "group": "test",
      "problemMatcher": ["$maven"]
    }
  ]
}